# Copy to .env only for normal local/prod mode. The demo profile needs no .env.
# Do not put real credentials in this example file or commit .env.
DB_URL=jdbc:h2:file:./data/amaliyot;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=amaliyot
DB_PASSWORD=

# Required in prod. Generate 32 random bytes as Base64; see README.md.
JWT_SECRET_BASE64=
JWT_TOKEN_MINUTES=60

# Required only when provisioning the first real Super Admin.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=

UPLOAD_DIR=uploads
SWAGGER_ENABLED=false
